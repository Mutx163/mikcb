<!--
Compose 迁移 Phase 1 专属 manifest（仅 composeP1 变体合并）。
只做一件事：把 launcher 入口从 Flutter MainActivity 换成 ComposeP1Activity。
其余全部继承 main manifest（10 个小组件 Provider / 服务 / 保活 / 权限原样保留）——
这正是 Phase 1 真机验证要证明的东西：同包名覆盖安装后这些系统侧组件一个不坏。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- 禁用 Flutter 入口（工具 attr 而非删节点：main 源集原样，只在 P1 合并时失效） -->
        <activity
            android:name=".MainActivity"
            android:enabled="false"
            tools:node="merge" />

        <!--
          主题走 ComposeShellTheme（继承 LaunchTheme，只多了透明系统栏与图标极性）。
          理由与实测见 res/values/styles.xml 里那段注释：LaunchTheme 的平台默认值就是
          「黑系统栏 + 白图标」，壳的活动不换主题，每个页面上下就是两条黑边。
        -->
        <activity
            android:name=".ComposeP1Activity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/ComposeShellTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
