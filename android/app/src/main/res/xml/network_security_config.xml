<?xml version="1.0" encoding="utf-8"?>

<!--
  Global cleartext (HTTP) permit.

  History: the release build allowed cleartext globally (e7b66009), was
  tightened to a 40-domain allowlist enumerated from the adapter warehouse
  (91d7ab16, Ref #9, shipped in v2.1.1.5), then reverted to a global permit
  here. The static allowlist could not keep up with the warehouse: new
  HTTP-only campus portals are added to the adapter repository continuously,
  and every one of them missed by the enumeration got blocked in the course
  import WebView with ERR_CLEARTEXT_NOT_PERMITTED. The import_url set is
  inherently unenumberable at build time, so the allowlist approach is not
  maintainable for this app.

  Scope note: most cleartext traffic never reaches this policy anyway -
  WebDAV sync, LAN edit and mirror downloads run on the Dart network stack
  (dart:io), which is not governed by Android's network security config.
  The WebView stack (campus portal login for course import) is the only
  governed path, and it must reach arbitrary campus hosts chosen by users.

  Debug builds use src/debug/res/xml/network_security_config.xml,
  which also permits cleartext globally.
-->
<network-security-config>

    <!-- Cleartext HTTP permitted app-wide; trust anchors stay system-only. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
