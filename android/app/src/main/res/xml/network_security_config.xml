<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext (HTTP) for all builds.

  Many campus academic portals, custom WebDAV NAS boxes, and LAN edit still use
  HTTP. Blocking cleartext would break school course import on release packages.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
