<?xml version="1.0" encoding="utf-8"?>

<!--
  Cleartext (HTTP) allowlist instead of a global switch.

  Most cleartext traffic in this app never reaches this policy: WebDAV
  sync, LAN edit and mirror downloads run on the Dart network stack
  (dart:io), which is not governed by Android's network security config.
  The WebView stack (campus portal login for course import) IS governed.

  Campus academic portals that only serve HTTP are enumerated below
  (all http:// import_url hosts from the qingyu_warehouse adapter
  repository, plus localhost/127.0.0.1 for local adapters during
  development). Keep this list in sync with the adapter repository. IP
  literals are fine here too: NSC domain matching is a plain string compare
  (exact or includeSubdomains suffix) in ApplicationConfig, so exact-match IP
  entries do work - but ONLY with includeSubdomains="false" (an IP can never
  be a dot-suffix of another hostname).

  Debug builds use src/debug/res/xml/network_security_config.xml,
  which still permits cleartext globally.
-->
<network-security-config>

    <!-- Default for everything not listed: HTTPS only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local loopback: LAN edit host page, local WebDAV servers, dev adapters. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Umeng analytics endpoints (native SDK, plaintext fallback). Keep the
         scope tight: umeng.com/uc.cn/ucweb.com are Umeng-owned hosts. Do NOT
         add broad CDNs (e.g. *.aliyuncs.com) here - those are shared by third
         parties and would open a plaintext exfiltration channel. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">umeng.com</domain>
        <domain includeSubdomains="true">uc.cn</domain>
        <domain includeSubdomains="true">ucweb.com</domain>
    </domain-config>

    <!-- HTTP-only campus portals (course import WebView). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">211.86.128.194</domain>
        <domain includeSubdomains="false">jwmis.cfec.edu.cn</domain>
        <domain includeSubdomains="false">dc.cqcivc.cn</domain>
