<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <!-- 主行：与旧版完全一致的单行形态，矮高度时就是整卡内容。 -->
        <LinearLayout
            android:id="@+id/strip_main_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_strip_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_status_chip_strong"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingLeft="9dp"
                android:paddingTop="3dp"
                android:paddingRight="9dp"
                android:paddingBottom="3dp"
                android:text="下一节课"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_strip_course"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="48dp"
                android:text="高等数学"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_strip_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:maxEms="10"
                android:maxLines="1"
                android:text="08:00 - 09:40"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_strip_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="第6周"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 第二行：默认隐藏；启动器给到的高度超过一行所需时由 provider 亮出，
             避免拉高的横条只剩孤零零一线居中内容。 -->
        <LinearLayout
            android:id="@+id/strip_sub_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/strip_sub_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/strip_sub_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- 第三行：高度充裕时的延伸信息（明日首课/次日第二节/考试倒计时）。 -->
        <TextView
            android:id="@+id/strip_sub2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#64748B"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
