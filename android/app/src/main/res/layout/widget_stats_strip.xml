<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <!-- 主行：与旧版完全一致的单行形态。 -->
        <LinearLayout
            android:id="@+id/strip_main_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stats_strip_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_status_chip_strong"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingLeft="9dp"
                android:paddingTop="3dp"
                android:paddingRight="9dp"
                android:paddingBottom="3dp"
                android:text="第 6 周"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stats_strip_sections"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="本周 12 节"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stats_strip_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="较上周 +2 节"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/stats_strip_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="80dp"
                android:layout_height="6dp"
                android:layout_marginLeft="10dp"
                android:max="100"
                android:progressTint="#2563EB"
                android:progressBackgroundTint="#E2E8F0" />

        </LinearLayout>

        <!-- 第二行：默认隐藏；高度足够时显示完整环比 + 进度百分比，避免拉高后整卡只有孤零零一线。 -->
        <LinearLayout
            android:id="@+id/strip_sub_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/stats_strip_sub_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/stats_strip_sub_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
