<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_status_chip_strong"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="下一节课"
            android:textColor="@color/widget_ink_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 课程色竖条与课程名同排：默认隐藏，开启「课程颜色」后由 provider
             上色亮出。用 TextView 承载而不是纯色块：颜色走文字色通道（背景色
             在部分 ROM 的重渲染里会被静默丢掉，见 applyAccentBar 注释），字符
             是整块字符「███」，由 3dp 宽度居中裁成实心竖条；不用裸
             View/Space/ImageButton（部分 ROM 的 RemoteViews 白名单不含它们）。

             高度跟着课名走：alignTop + alignBottom 两条边都钉在课名上时，
             相对布局按课名的高度把条 EXACTLY 测量一次（两端都固定 →
             getChildMeasureSpec 走 EXACTLY 分支），所以课名一行条就一行高、
             课名折成两行条就两行高，不用去猜行数。下面写的 layout_height
             只是兜底值与横向测量那一趟的高度，最终高度以这两条对齐规则为准。
             条里的字墨要恒高于条高，否则字墨比视图矮会在两端露出透明：
             textSize 按「两行 19sp 课名（provider 的最宽档）也盖得住」取，
             超出的部分被自身边界裁掉（与原 24sp 字墨撑在 17dp 里依赖的是
             同一条 clipChildren，没有新增依赖）。 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/widget_course_name_accent"
                android:layout_width="3dp"
                android:layout_height="17dp"
                android:layout_alignParentStart="true"
                android:layout_alignTop="@id/widget_course_name"
                android:layout_alignBottom="@id/widget_course_name"
                android:layout_marginEnd="6dp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="&#9608;&#9608;&#9608;"
                android:textColor="@android:color/transparent"
                android:textSize="64sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_course_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/widget_course_name_accent"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="高等数学"
                android:textColor="@color/widget_ink_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 时间/教室行。左内边距在运行时由 provider 按色条是否亮着补
             （TodayWidgetSupport.applyHeroTextGutter）：色条亮时补 9dp，
             与课名起始字对齐；色条不亮时归零，回到卡片默认边距。
             这里不要再给静态 paddingLeft，会被那份下发整体覆盖。 -->
        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="08:00 - 09:40"
            android:textColor="@color/widget_ink_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
