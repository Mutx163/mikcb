<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stats_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_status_chip_strong"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="第 1 周"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stats_progress_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="right"
                android:maxLines="1"
                android:text="已上 30 / 共 160 节"
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/stats_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressTint="#2563EB"
            android:progressBackgroundTint="#E2E8F0" />

        <TextView
            android:id="@+id/stats_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="本周 12 节 · 6 门课"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stats_delta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="较上周 +2 节"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- 上弹性空隙：白名单 LinearLayout 占位（部分 ROM 拒载 Space/普通 View），
             与下方空隙均分剩余高度，把「百分比·日均」带顶到卡片正中段。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 中段带：必须拆成两条全宽短行。任何含「 · 」的合并长句在真机
             2 列宽（约150dp）都会被 ellipsize 成「0.…」式假小数点。
             全宽单行与底部必修/连续行同构，是最稳妥的形态。 -->
        <TextView
            android:id="@+id/stats_extra_pct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="已上 18%"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stats_extra_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="日均约 4.4 节"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 下弹性空隙：与上方对称，让底部明细区贴住下边缘。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/stats_nature_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stats_nature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="必修 4 · 选修 2"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/stats_streak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="最长连续 5 天"
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
