<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ mandatory system splash window cannot be removed; it is
         stripped to the bare background color (transparent icon, no branding
         image) and exists only for the process-start instant. Startup
         branding is drawn by the app's own Flutter splash
         (lib/widgets/app_startup_splash.dart), which owns the first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
