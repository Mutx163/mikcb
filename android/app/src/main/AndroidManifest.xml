<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.example.university_timetable" />
        <package android:name="com.example.university_timetable.debug" />
        <!-- Feedback channel deep links (Coolapk / Xiaohongshu / QQ / WeChat) -->
        <package android:name="com.coolapk.market" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="coolmarket" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="xhsdiscover" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqopensdkapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <!-- 校园小工具：取件身份码 / 待取快递直达（入口数据与 QuickJump 同源）。
             Android 11+ 包可见性：
             · <package> 让 getLaunchIntentForPackage / getPackageInfo 查得到（用于
               「直达失败就拉起 App」与「入口体检」里的已安装判断）；
             · <intent> + scheme 让 queryIntentActivities 能判断这条 deeplink 有没有
               App 接。不申请 QUERY_ALL_PACKAGES：用户自建的其它 scheme 只会失去
               「能不能点」的预判，实际 startActivity 不受影响。 -->
        <package android:name="com.cainiao.wireless" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.jingdong.app.mall" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.ss.android.ugc.aweme.lite" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="cainiao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="taobao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tbopen" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="pinduoduo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="openjd" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="snssdk1128" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="snssdk2329" />
        </intent>
        <!-- 系统闹钟（这节课闹钟）：包可见性探测 -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- QR face-to-face transfer camera scanning -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- 这节课闹钟静默写入（EXTRA_SKIP_UI）所需权限，确认页模式可不依赖 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- 上课前快捷操作改写铃声模式（静音/取消静音）必需：缺此权限时
         AudioManager.setRingerMode 在框架内被静默丢弃（不抛异常也不生效），
         表现为点了「取消静音」毫无反应。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- 截屏检测（Android 14+ 官方 Activity.registerScreenCaptureCallback）。
         普通权限，安装即授予、不弹框、读不到截图内容，系统只告知「截了一张」。
         低于 14 的系统不认识该权限，声明本身无副作用。 -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE"/>

    <!-- 天气「使用当前位置」。
         COARSE 必须与 FINE 同时声明：Android 12+ 只声明 FINE 会直接 lint 失败，
         且两者同在时系统才会弹「精确 / 大致」二选一；用户选「大致」时功能照常，
         天气本来就按区级算。只在用户点「使用当前位置」时才申请，不随启动索取。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- 一键同步课表到系统日历（CalendarSync.kt）：读写专属本地日历。
         运行时权限，只在用户点「同步到系统日历」时申请，不随启动索取。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>

    <!-- fullBackupContent / dataExtractionRules：系统备份规则，两套并存。
         API 31+ 读 dataExtractionRules（分「云备份 / 换机直传」两段），
         API 30 及以下读 fullBackupContent。本项目 minSdk = 33（Android 13）⇒
         运行时只有 dataExtractionRules 生效；fullBackupContent 仍保留，供
         万一回调 minSdk 时的旧设备兜底，当前不参与实际备份决策。
         此前两个属性都没声明 = 走系统默认（全量备份），课表与三组加密凭据
         一起进云。规则内容与取舍见 res/xml/ 下两个文件的注释。 -->
    <application
        android:name=".UmengApplication"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/QingyuWidgetTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- transfer/ics 共用 FileProvider（Lead 2026-10-29 添加）。
             2026-10-29 之前全仓 6 个 manifest 一条 provider 都没有 ⇒ 任何「导出并分享」
             （ICS 日历、.mikcb 传输包）在代码路径上**必然**落到「provider 不可用」分支。
             authority 后缀必须与 share/TransferShareContract.PROVIDER_AUTHORITY_SUFFIX、
             pages/export/IcsShareLogic 的同名常量逐字一致；
             路径白名单见 res/xml/file_paths.xml（只授 cacheDir 下两个子目录）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 分享面板「用户选了谁」的回执接收器（2026-11-05 按 Chief 授权添加，仅此一行声明）。
             ICS 导出的「已取消分享日历 / 已导出并分享 N 个」靠它判：系统只在用户**真的选定目标**时
             往 `Intent.createChooser(intent, title, sender)` 的 sender 投 EXTRA_CHOSEN_COMPONENT，
             划掉面板则不投（发布版 share_plus 的 SharePlusPendingIntent 同一套声明方式）。
             不声明时 `prepareShare` 会判「通道不可用」，宿主对「没回执」保持沉默，不谎报取消。 -->
        <receiver
            android:name=".platform.IcsShareResultReceiver"
            android:exported="false" />
        <!-- 正式包启动页 = Compose 壳（2026-11-02 从 Flutter 的 .MainActivity 切过来）。
             dev / perf 两个渠道此前各自在自己的清单里声明过这一段；启动页落进 main 后
             它们只保留「关掉 MainActivity」那一条，不再重复声明本 Activity
             （两边都声明会在合并清单里留下同名 Activity 与两条 launcher intent-filter）。

             回退方式（不改代码，只动本文件）：把下面这段 MAIN/LAUNCHER intent-filter
             挪回 .MainActivity 即可，其余过滤规则本来就在 MainActivity 上。 -->
        <!-- 2026-11-07 平板/横屏适配（第 R02 项）：两个 Activity 不再锁 `portrait`。
             理由：`targetSdk = 36` 起，Android 16 在宽度 ≥600dp 的设备上本来就会忽略方向锁
             （Android 17 起连 opt-out 都没有），锁住只让 Android 13–15 的平板拿不到宽屏布局。
             回退 = 把 `android:screenOrientation="portrait"` 加回两个 <activity> 即可。 -->
        <activity
            android:name=".pages.PagesShellActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/ComposeShellTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 去 Flutter 化 P4-B（2026-11-07）：`.MainActivity`（FlutterActivity）已删除。
             它的外部入口（VIEW/SEND 导入、umeng scheme、mikcb-debug 深链）自 2026-11-02 起
             全挂在 .pages.ShellExternalEntryActivity 上，这里不再需要声明。 -->

        <!-- 外部入口跳板（R1 补口 2026-11-02）：VIEW/SEND 文件导入、umeng scheme、
             （debug overlay 的）mikcb-debug 深链都先落到这里。透明 + noHistory +
             excludeFromRecents，用户感知不到这一跳；解析/读取逻辑在
             pages/ShellExternalEntryActivity.kt 与纯 Kotlin 的
             pages/shell/ShellExternalEntry.kt，解析完把壳拉到前台并带上落点
             （PagesShellActivity 组合树里 ShellExternalEntryEffect 一行消费）。
             过滤规则自 .MainActivity 原样搬移（逐条未改，2026-11-02）。 -->
        <activity
            android:name=".pages.ShellExternalEntryActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${umengScheme}" />
            </intent-filter>

            <!-- Supported import types: .ics, .mikcb, .json, .csv, .xlsx -->

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>

            <!-- Mi Share and file managers often label unknown extensions as octet-stream -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.ics" android:pathSuffix=".ics" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.ics" android:pathSuffix=".ics" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.mikcb" android:pathSuffix=".mikcb" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.mikcb" android:pathSuffix=".mikcb" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.json" android:pathSuffix=".json" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.json" android:pathSuffix=".json" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.csv" android:pathSuffix=".csv" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.csv" android:pathSuffix=".csv" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.xlsx" android:pathSuffix=".xlsx" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.xlsx" android:pathSuffix=".xlsx" />
            </intent-filter>
        </activity>

        <service
            android:name=".LiveUpdateService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Course live activity and schedule reminders while class is in progress" />
        </service>

        <service
            android:name=".LanEditForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="LAN edit HTTP server for timetable editing from a desktop browser" />
        </service>

        <service
            android:name=".KeepAliveAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:enabled="true"
            android:exported="false"
            android:label="@string/accessibility_keep_alive_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/keep_alive_accessibility_service" />
        </service>

        <!-- Filtered actions are all protected system broadcasts (delivered by the
             system even when not exported); custom ACTION_TRIGGER is only delivered
             via explicit Component PendingIntent from this app. Nothing here needs
             to be reachable by other apps. -->
        <receiver
            android:name=".LiveUpdateReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Explicit PendingIntent delivers ACTION_FIRE; boot/time filters re-arm.
             Non-exported: system still delivers protected broadcasts; other apps
             can no longer forge fires with enumerable requestCodes. -->
        <receiver
            android:name=".ExamReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- 日程提醒：显式 PendingIntent 投递 ACTION_FIRE；开机/更新/改时区后按快照补排。
            不导出：受保护系统广播仍由系统送达，外部应用无法伪造 requestCode / id+offset。 -->
        <receiver
            android:name=".ScheduleReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Weekly report: explicit PendingIntent delivers ACTION_FIRE; boot/time filters re-arm.
             Non-exported so other apps cannot trigger the post / roll-forward. -->
        <receiver
            android:name=".WeeklyReportReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TodayCompactWidgetProvider"
            android:label="@string/widget_today_compact_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_compact_info" />
        </receiver>

        <receiver
            android:name=".TodayMiniListWidgetProvider"
            android:label="@string/widget_today_mini_list_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_mini_list_info" />
        </receiver>

        <receiver
            android:name=".TodayMediumWidgetProvider"
            android:label="@string/widget_today_medium_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_medium_info" />
        </receiver>

        <receiver
            android:name=".TodayLargeWidgetProvider"
            android:label="@string/widget_today_large_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_large_info" />
        </receiver>

        <receiver
            android:name=".StatsCompactWidgetProvider"
            android:label="@string/widget_stats_compact_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_compact_info" />
        </receiver>

        <receiver
            android:name=".StatsMediumWidgetProvider"
            android:label="@string/widget_stats_medium_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_medium_info" />
        </receiver>

        <receiver
            android:name=".TodayStripWidgetProvider"
            android:label="@string/widget_today_strip_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_strip_info" />
        </receiver>

        <receiver
            android:name=".StatsStripWidgetProvider"
            android:label="@string/widget_stats_strip_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_strip_info" />
        </receiver>

        <receiver
            android:name=".ExamCountdownWidgetProvider"
            android:label="@string/widget_exam_card_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_exam_card_info" />
        </receiver>

        <receiver
            android:name=".TodayWideWidgetProvider"
            android:label="@string/widget_today_wide_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_wide_info" />
        </receiver>

        <!-- Refresh helper (not an AppWidgetProvider): all filter actions are
             protected system broadcasts or this app's own explicit PendingIntent;
             widget providers below stay exported for the system/launcher. -->
        <receiver
            android:name=".HomeWidgetRefreshReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
            
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Live backdrop blur requires Impeller. See .trellis/spec/flutter/hyperos-blurred-header.md.
             Set false to restore v1.1.5-a Vulkan crash workaround (tint-only headers). -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true" />
    </application>
