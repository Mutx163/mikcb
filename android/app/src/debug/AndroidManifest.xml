<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds relax cleartext via src/debug/res/xml/network_security_config.xml
         (base-config cleartextTrafficPermitted=true). Do NOT set
         android:usesCleartextTraffic here: when it coexists with
         android:networkSecurityConfig the manifest attribute wins and would
         override the NSC allowlist in release merges. -->
</manifest>
