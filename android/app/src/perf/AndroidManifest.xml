<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
        perf flavor（轻屿课表性能版）专属覆盖，2026-11-02 加。

        只做一件事：关掉 Flutter 的 MainActivity，确保 perfBench 打出来点开是 Compose 壳。

        启动页（.pages.PagesShellActivity + MAIN/LAUNCHER）自 2026-11-02 起声明在
        src/main/AndroidManifest.xml（正式包一起切壳），这里不再重复声明——
        两边都声明会在合并后的清单里留下同名 Activity 与两条 launcher intent-filter。
        -->
        <activity
            android:name=".MainActivity"
            android:enabled="false"
            tools:node="merge" />
    </application>
</manifest>
