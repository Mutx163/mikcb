<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- dev flavor 专属：只关掉 Flutter 的 MainActivity。
             启动页（.pages.PagesShellActivity + MAIN/LAUNCHER）自 2026-11-02 起声明在
             src/main/AndroidManifest.xml，这里不再重复声明——两边都声明会在合并后的
             清单里留下同名 Activity 与两条 launcher intent-filter。 -->
        <activity
            android:name=".MainActivity"
            android:enabled="false"
            tools:node="merge" />
    </application>
</manifest>
