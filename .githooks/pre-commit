#!/bin/sh
# 提交前门禁：两道「静默失效、CI 才发现」的本地检查。
#
# 为什么需要它：CI 跑的是无过滤的 `flutter test` + `flutter analyze --fatal-infos`
# （.github/workflows/ci.yml）。缺的不是强制点，是**推送前的本地反馈**——
# 2026-09-29 实测：三个提交净增 156 行、一次都没碰守卫测试；2026-10-08 两个
# 测试提交带进两条 info 级 lint，本地没人跑 analyze，CI 从 10-09 连红十几次。
# 「CI 红了」在忙的时候很容易被当成「又红了一直红着」。
#
# 第一道：架构守卫（test/architecture/，实测 21 条 / 5.8 秒）。不跑全量
# `flutter test`：全量要几分钟，一旦慢到让人养成 `--no-verify` 的习惯，
# 这道门禁就等于不存在。
#
# 守卫读的是**本次提交的快照**，不是工作区（2026-10-20 晚改）：先 `git
# checkout-index` 把索引物化到临时目录、经 MIKCB_GUARD_SNAPSHOT 交给守卫。
# 守卫套件也从**快照里的** test/architecture/ 跑（不是工作区那份）：工作区里
# 别的会话未提交、未跟踪的守卫测试文件（甚至语法错的）不会被编译，守卫逻辑
# 也取提交里的版本。动机：索引=提交内容（普通提交与路径限定提交都成立），
# 工作区里并行会话的在途改动本来就不属于这次提交——此前守卫读工作区，
# 2026-10-19 一晚 45 次 --no-verify 大半是「别人的在途半成品顶爆棘轮」的误伤；
# 先试过红项归因（guard_attribution.sh），但「域内混入在途改动就放行」在设置域
# 常脏的现实下会把真实回归也放过去，当天即废。守卫红了再以 HEAD 快照对照一次：
# HEAD 绿 ⇒ 本次提交引入，拦下；HEAD 也红 ⇒ 基线早已失守，先同步基线。
# 守卫读文件的纪律由 test/architecture/guard_source.dart + 其纪律测试维持。
#
# 第二道：analyze 门禁（2026-10-11 新增）。暂存的 .dart 逐批过
# `dart analyze --fatal-infos`（info 级也算失败，与 CI 同口径），用 `dart`
# 而不是 `flutter` 是为了绕开 Git Bash 下 ProgramFiles(x86) 环境变量的坑
# （flutter.bat 会展开它，见 AGENTS.md 工具链节）。只分析**暂存**的文件：
# 全仓 analyze 约 21 秒，且会把其他 Agent 正在改的半成品也报出来，
# 在这个约 5 个 Agent 并行的共享工作区里等于误伤。CI 侧照旧全量兜底。
#
# 为什么不把 `tool/audit_cjk_hardcode.py` 也放进来（它同样是 CI 门禁、同样快）：
# 棘轮模式在发现改善时会**自动改写** `tool/cjk_hardcode_baseline.txt`。放进钩子
# 等于每次提交都可能把工作区弄脏出一个未暂存的改动，比它拦住的回归更烦人。
#
# 本钩子的定位是「快速本地反馈」，**不是第二道 CI**。所以工具链自己起不来的时候
# 它选择放行并提醒，而不是拦住提交——门禁一旦因环境问题锁死所有提交，
# 就只会被 `--no-verify` 绕过，反而更糟。
#
# 逃生舱：git 约定俗成的 `--no-verify`（`git commit --no-verify`）。真被误伤时
# 用它跳过，然后**立刻**手动补跑（命令见 README 与各段拦截提示），并在
# .agents/no-verify-log.md 追加一行留痕——跳过次数涨起来就是规则失效的信号。
# （2026-10-21 起这一步由 post-commit 自动记，见该文件头注释；不用再手写。）
#
# 超时护栏（2026-10-21 新增）：两道 flutter test 各包 `timeout 300`。此前无超时，
# 2026-10-20 18:13 实测卡死过一次、持锁 15 分钟，挡住工作区所有其他会话的提交。
# 守卫红时本钩子会跑**两遍**（提交快照 + HEAD 快照），所以单次上限必须存在。
# `timeout` 来自 coreutils，Git Bash 自带（实测 8.32）；缺失时退回裸调用（不因缺工具拦提交）。

set -e

# 超时包装：$1=秒数，其余=命令。timeout 不存在时降级为直接执行。
run_timeout() {
  _secs=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_secs" "$@"
  else
    "$@"
  fi
}

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged=$(git diff --cached --name-only)

# 架构守卫只认它自己的对象：lib/ 与 android/ 的源码与资源、守卫测试本身、pubspec。
guard_relevant=$(printf '%s\n' "$staged" | grep -E '^(lib/|test/architecture/|android/|pubspec\.yaml)' || true)

# analyze 门禁认所有暂存的 .dart（lib/ test/ integration_test/ tool/ 一视同仁）。
dart_staged=$(printf '%s\n' "$staged" | grep -E '\.dart$' || true)

out_file=$(mktemp)
out_head_file=$(mktemp)
snapshot=""
snapshot_head=""
cleanup() {
  rm -f "$out_file" "$out_head_file"
  [ -n "$snapshot" ] && rm -rf "$snapshot"
  [ -n "$snapshot_head" ] && rm -rf "$snapshot_head"
  true
}
trap cleanup EXIT

# 把当前索引物化成磁盘快照（git checkout-index），供守卫读「本次提交的内容」。
# 普通提交时索引=共享暂存区；路径限定提交时 git 会给钩子一个临时索引
# （GIT_INDEX_FILE=next-index-*.lock，只含本次提交的路径更新）——两种方式下
# 物化结果都精确等于提交内容，工作区里别人的在途改动不在其中。
materialize() {
  # $1 = 目标目录（已存在）；物化 HEAD 树时额外把临时索引的路径放 $2
  local win
  win=$(cygpath -m "$1" 2>/dev/null) || win=$(cd "$1" && pwd -W 2>/dev/null) || win="$1"
  if [ "$2" = "HEAD" ]; then
    local tmpidx
    tmpidx=$(mktemp)
    GIT_INDEX_FILE="$tmpidx" git read-tree HEAD
    GIT_INDEX_FILE="$tmpidx" git checkout-index -a --prefix="$win/"
    rm -f "$tmpidx"
  else
    git checkout-index -a --prefix="$win/"
  fi
}

# ---- 第一道：架构守卫（读提交快照，不读工作区） ----

if [ -n "$guard_relevant" ]; then
  if ! command -v flutter >/dev/null 2>&1; then
    echo "pre-commit: 找不到 flutter，跳过架构守卫（CI 仍会兜住）。" >&2
  else
    echo "pre-commit: 跑架构守卫（读本次提交快照，约 8 秒）..."

    snapshot=$(mktemp -d)
    if ! materialize "$snapshot"; then
      echo "pre-commit: 提交快照物化失败（合并冲突中的索引？），跳过本次架构守卫（CI 仍会兜住）。" >&2
    else
      snap_win=$(cygpath -m "$snapshot" 2>/dev/null || echo "$snapshot")
      set +e
      MIKCB_GUARD_SNAPSHOT="$snap_win" \
        run_timeout 300 flutter test "$snap_win/test/architecture/" --timeout 60s >"$out_file" 2>&1
      rc=$?
      set -e

      # 124 = timeout 杀掉的。工具链卡死与「守卫红」必须分开：卡死不是代码问题，
      # 按本钩子「环境问题就放行」的既定原则处理，否则会把所有人挡在门外。
      if [ "$rc" -eq 124 ]; then
        echo "" >&2
        echo "pre-commit: 架构守卫超过 300 秒未完成，已中止并跳过本次守卫（CI 仍会兜住）。" >&2
        echo "pre-commit: 若反复出现，按 .githooks/README.md「卡死排查」逐个单跑守卫定位慢的那个。" >&2
        rc=0
      fi

      if [ "$rc" -ne 0 ]; then
        # 工具链起不来 ≠ 守卫不过。这两种失败必须分开，否则本机 Flutter 一出毛病
        # 就会拦住所有提交，而那报错与代码无关、也没法就地修。实测踩到过的签名见下。
        if grep -qE 'Unable to determine engine version|Error: Unable to|Could not find a command named|Error: .*not found' "$out_file"; then
          echo "" >&2
          echo "pre-commit: flutter 工具链自己没跑起来，跳过本次架构守卫（CI 仍会兜住）。" >&2
          echo "pre-commit: 下面这段是工具链的报错，不是守卫结论：" >&2
          sed 's/^/    /' "$out_file" >&2
        else
          # 对照 HEAD：红项是本次提交引入的，还是 HEAD 上本就红的
          #（先前的提交越过基线没同步，参照 99905c37 的同步做法）。
          snapshot_head=$(mktemp -d)
          head_win=$(cygpath -m "$snapshot_head" 2>/dev/null || echo "$snapshot_head")
          head_materialized=1
          set +e
          if ! materialize "$snapshot_head" HEAD; then
            head_materialized=0
          else
            MIKCB_GUARD_SNAPSHOT="$head_win" \
              run_timeout 300 flutter test "$head_win/test/architecture/" --timeout 60s >"$out_head_file" 2>&1
            head_rc=$?
          fi
          set -e

          # HEAD 快照超时同样是环境问题：按「HEAD 也红」处理会误导成「基线失守」，
          # 所以单独识别并说明（归属未知，但仍按本次引入拦下——宁可多问一句）。
          if [ "${head_rc:-0}" -eq 124 ]; then
            echo "" >&2
            echo "pre-commit: 对照用的 HEAD 守卫超过 300 秒未完成，无法判断红项归属。" >&2
            head_materialized=2
          fi

          echo "" >&2
          sed 's/^/    /' "$out_file" >&2
          echo "" >&2
          if [ "$head_materialized" = 0 ]; then
            echo "pre-commit: 架构守卫红，但 HEAD 快照物化失败，无法判断红项归属；按本次提交引入处理（保守）。" >&2
          elif [ "$head_materialized" = 2 ]; then
            echo "pre-commit: 架构守卫红，但对照用的 HEAD 守卫超时，无法判断红项归属；按本次提交引入处理（保守）。" >&2
          elif [ "$head_rc" -ne 0 ]; then
            echo "pre-commit: 架构守卫红，且 HEAD 本身已红 —— 先前的提交越过基线没同步基线。" >&2
            echo "pre-commit: 在重测同步基线（参照 99905c37）或修复超标文件之前，任何提交都会被拦；" >&2
            echo "pre-commit: 这不是你一个人的问题，别 --no-verify 硬闯，把基线同步掉就都通了。" >&2
          else
            echo "pre-commit: 架构守卫红，HEAD 上是绿的 ⇒ 红项由本次提交引入，拦下。" >&2
            echo "pre-commit: 行数/依赖扇入棘轮是**只降不升**的，改动该拆就拆，" >&2
            echo "           别用抬基线的方式把它变绿——抬之前先问这次增长能不能下沉。" >&2
          fi
          echo "pre-commit: 确属门禁 bug、确需跳过时用 git commit --no-verify，" >&2
          echo "           但必须手动补跑本命令，并在 .agents/no-verify-log.md 追加一行留痕。" >&2
          exit 1
        fi
      fi
    fi
  fi
fi

# ---- 第二道：analyze 门禁 ----

dart_existing=""
if [ -n "$dart_staged" ]; then
  # 删掉的文件在磁盘上已不存在，analyze 会报 uri 不存在，先滤掉。
  dart_existing=$(printf '%s\n' "$dart_staged" | while IFS= read -r f; do
    if [ -f "$f" ]; then printf '%s\n' "$f"; fi
  done)
fi

if [ -n "$dart_existing" ]; then
  if ! command -v dart >/dev/null 2>&1; then
    echo "pre-commit: 找不到 dart，跳过 analyze 门禁（CI 仍会兜住）。" >&2
  else
    echo "pre-commit: dart analyze --fatal-infos 暂存的 Dart 文件（$(printf '%s\n' "$dart_existing" | wc -l) 个，首跑约 20 秒）..."

    set +e
    # shellcheck disable=SC2086  # 有意按空白展开：本仓源码路径不含空格
    run_timeout 300 dart analyze --fatal-infos $dart_existing >"$out_file" 2>&1
    rc=$?
    set -e

    if [ "$rc" -eq 124 ]; then
      echo "pre-commit: dart analyze 超过 300 秒未完成，已中止并跳过本道门禁（CI 仍会兜住）。" >&2
      rc=0
    fi

    if [ "$rc" -ne 0 ]; then
      # 与架构守卫同一条原则：工具链没跑起来就放行，别把人逼成 --no-verify。
      if grep -qE 'Unable to determine engine version|Error: Unable to|Could not find a command named|Error: .*not found|dart: command not found|Failed to create server socket' "$out_file"; then
        echo "pre-commit: dart 工具链没跑起来，跳过 analyze 门禁（CI 仍会兜住）。" >&2
        sed 's/^/    /' "$out_file" >&2
      else
        echo "" >&2
        sed 's/^/    /' "$out_file" >&2
        echo "" >&2
        echo "pre-commit: analyze 没过，本次提交已拦下（--fatal-infos：info 级也算失败）。" >&2
        echo "pre-commit: 就地修掉；确认是误伤可用 git commit --no-verify，但请手动补跑：" >&2
        echo "           dart analyze --fatal-infos $dart_existing" >&2
        exit 1
      fi
    fi
  fi
fi

# ---- 走完全部门禁：标记「这次提交正常走了检查」 ----
#
# post-commit 靠这个标记区分「正常提交」与「--no-verify 跳过了」。
# 关键约束（2026-10-21 实测得出，别改）：**只在所有 exit 1 之后写**。
# 若写在开头，守卫拦下→用 --no-verify 重试同一内容时标记还在，
# 那次最该被抓的跳过会被记成正常提交（实测复现过）。
#
# 用提交树哈希当键、不用「标记存在与否」：多会话并行时两个提交会交错跑
# post-commit（实测强制交错可复现），树哈希能精确对上自己那次提交。
# 反过来 post-commit 里必须一开始就把 HEAD 钉死——实测过晚读 HEAD 会把
# 结论记到别人刚推上去的提交上。
tree=$(git write-tree 2>/dev/null || true)
if [ -n "$tree" ]; then
  gd=$(git rev-parse --git-dir)
  printf '%s\t%s\n' "$tree" "$(date +%s)" >> "$gd/pre-commit-ok.log" 2>/dev/null || true
fi

exit 0
