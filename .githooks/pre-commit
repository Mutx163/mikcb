#!/bin/sh
# 提交前门禁：两道「静默失效、CI 才发现」的本地检查。
#
# 为什么需要它：CI 跑的是无过滤的 `flutter test` + `flutter analyze --fatal-infos`
# （.github/workflows/ci.yml）。缺的不是强制点，是**推送前的本地反馈**——
# 2026-09-29 实测：三个提交净增 156 行、一次都没碰守卫测试；2026-10-08 两个
# 测试提交带进两条 info 级 lint，本地没人跑 analyze，CI 从 10-09 连红十几次。
# 「CI 红了」在忙的时候很容易被当成「又红了一直红着」。
#
# 第一道：架构守卫（test/architecture/，实测 21 条 / 5.8 秒）。不跑全量
# `flutter test`：全量要几分钟，一旦慢到让人养成 `--no-verify` 的习惯，
# 这道门禁就等于不存在。
#
# 第一道失败时不再一律拦下（2026-10-20 加归因）：守卫读的是**整个工作区**，
# 并行会话的在途改动会顶爆别人的域、把无辜的提交拦下——2026-10-19 一晚
# 4 次 --no-verify 全是并行误伤。红项先过 .githooks/guard_attribution.sh
# 归因（域映射 .githooks/guard_domains.txt）：与本次提交无关、或域内混入
# 在途改动无法切分的自动放行并打印说明；确属本次提交引入的照旧拦下。
# 新增守卫测试时必须同步登记域映射，否则红项按「无法归因 = 本次引入」拦下。
#
# 第二道：analyze 门禁（2026-10-11 新增）。暂存的 .dart 逐批过
# `dart analyze --fatal-infos`（info 级也算失败，与 CI 同口径），用 `dart`
# 而不是 `flutter` 是为了绕开 Git Bash 下 ProgramFiles(x86) 环境变量的坑
# （flutter.bat 会展开它，见 AGENTS.md 工具链节）。只分析**暂存**的文件：
# 全仓 analyze 约 21 秒，且会把其他 Agent 正在改的半成品也报出来，
# 在这个约 5 个 Agent 并行的共享工作区里等于误伤。CI 侧照旧全量兜底。
#
# 为什么不把 `tool/audit_cjk_hardcode.py` 也放进来（它同样是 CI 门禁、同样快）：
# 棘轮模式在发现改善时会**自动改写** `tool/cjk_hardcode_baseline.txt`。放进钩子
# 等于每次提交都可能把工作区弄脏出一个未暂存的改动，比它拦住的回归更烦人。
#
# 本钩子的定位是「快速本地反馈」，**不是第二道 CI**。所以工具链自己起不来的时候
# 它选择放行并提醒，而不是拦住提交——门禁一旦因环境问题锁死所有提交，
# 就只会被 `--no-verify` 绕过，反而更糟。
#
# 逃生舱：git 约定俗成的 `--no-verify`（`git commit --no-verify`）。真被误伤时
# 用它跳过，然后**立刻**手动补跑（命令见 README 与各段拦截提示），并在
# .agents/no-verify-log.md 追加一行留痕——跳过次数涨起来就是规则失效的信号。

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged=$(git diff --cached --name-only)

# 架构守卫只认它自己的对象：lib/ 与 android/ 的源码与资源、守卫测试本身、pubspec。
guard_relevant=$(printf '%s\n' "$staged" | grep -E '^(lib/|test/architecture/|android/|pubspec\.yaml)' || true)

# analyze 门禁认所有暂存的 .dart（lib/ test/ integration_test/ tool/ 一视同仁）。
dart_staged=$(printf '%s\n' "$staged" | grep -E '\.dart$' || true)

out_file=$(mktemp)
trap 'rm -f "$out_file"' EXIT

# ---- 第一道：架构守卫 ----

if [ -n "$guard_relevant" ]; then
  if ! command -v flutter >/dev/null 2>&1; then
    echo "pre-commit: 找不到 flutter，跳过架构守卫（CI 仍会兜住）。" >&2
  else
    echo "pre-commit: 跑架构守卫（test/architecture/，约 6 秒）..."

    set +e
    flutter test test/architecture/ --timeout 60s >"$out_file" 2>&1
    rc=$?
    set -e

    if [ "$rc" -ne 0 ]; then
      # 工具链起不来 ≠ 守卫不过。这两种失败必须分开，否则本机 Flutter 一出毛病
      # 就会拦住所有提交，而那报错与代码无关、也没法就地修。实测踩到过的签名见下。
      if grep -qE 'Unable to determine engine version|Error: Unable to|Could not find a command named|Error: .*not found' "$out_file"; then
        echo "" >&2
        echo "pre-commit: flutter 工具链自己没跑起来，跳过本次架构守卫（CI 仍会兜住）。" >&2
        echo "pre-commit: 下面这段是工具链的报错，不是守卫结论：" >&2
        sed 's/^/    /' "$out_file" >&2
      else
        echo "" >&2
        echo "pre-commit: 架构守卫没过，先归因红项（守卫读整个工作区，红项可能来自并行在途改动）..." >&2
        if sh .githooks/guard_attribution.sh "$out_file"; then
          echo "pre-commit: 归因放行：红项与本次提交无关、或无法与在途改动切分。继续 analyze 门禁；CI 仍会兜底。" >&2
        else
          echo "" >&2
          sed 's/^/    /' "$out_file" >&2
          echo "" >&2
          echo "pre-commit: 架构守卫红项归因为本次提交引入，拦下。" >&2
          echo "pre-commit: 行数/依赖扇入棘轮是**只降不升**的，改动该拆就拆，" >&2
          echo "           别用抬基线的方式把它变绿——抬之前先问这次增长能不能下沉。" >&2
          echo "pre-commit: 确认归因有误、确需跳过时用 git commit --no-verify，" >&2
          echo "           但必须手动补跑本命令，并在 .agents/no-verify-log.md 追加一行留痕。" >&2
          exit 1
        fi
      fi
    fi
  fi
fi

# ---- 第二道：analyze 门禁 ----

dart_existing=""
if [ -n "$dart_staged" ]; then
  # 删掉的文件在磁盘上已不存在，analyze 会报 uri 不存在，先滤掉。
  dart_existing=$(printf '%s\n' "$dart_staged" | while IFS= read -r f; do
    if [ -f "$f" ]; then printf '%s\n' "$f"; fi
  done)
fi

if [ -n "$dart_existing" ]; then
  if ! command -v dart >/dev/null 2>&1; then
    echo "pre-commit: 找不到 dart，跳过 analyze 门禁（CI 仍会兜住）。" >&2
  else
    echo "pre-commit: dart analyze --fatal-infos 暂存的 Dart 文件（$(printf '%s\n' "$dart_existing" | wc -l) 个，首跑约 20 秒）..."

    set +e
    # shellcheck disable=SC2086  # 有意按空白展开：本仓源码路径不含空格
    dart analyze --fatal-infos $dart_existing >"$out_file" 2>&1
    rc=$?
    set -e

    if [ "$rc" -ne 0 ]; then
      # 与架构守卫同一条原则：工具链没跑起来就放行，别把人逼成 --no-verify。
      if grep -qE 'Unable to determine engine version|Error: Unable to|Could not find a command named|Error: .*not found|dart: command not found|Failed to create server socket' "$out_file"; then
        echo "pre-commit: dart 工具链没跑起来，跳过 analyze 门禁（CI 仍会兜住）。" >&2
        sed 's/^/    /' "$out_file" >&2
      else
        echo "" >&2
        sed 's/^/    /' "$out_file" >&2
        echo "" >&2
        echo "pre-commit: analyze 没过，本次提交已拦下（--fatal-infos：info 级也算失败）。" >&2
        echo "pre-commit: 就地修掉；确认是误伤可用 git commit --no-verify，但请手动补跑：" >&2
        echo "           dart analyze --fatal-infos $dart_existing" >&2
        exit 1
      fi
    fi
  fi
fi

exit 0
