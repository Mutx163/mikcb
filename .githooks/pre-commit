#!/bin/sh
# 提交钩子（2026-11-07 去 Flutter 化 P4-C 后）
#
# Dart 层已删除：`lib/`、`test/`、`integration_test/`、`pubspec.yaml` 都没了。
# 原 Flutter 架构守卫（`test/architecture/`）与 `dart analyze` 门禁已整条退役。
# Kotlin/Compose 的验证走 L0（scripts/test-kotlin-module.ps1）与 L1
# （scripts/safe-gradle.ps1 :app:compileDevDebugKotlin），**不放进提交钩子**：
# 单次 20 秒~2 分钟，放进来只会让 `--no-verify` 变成习惯。
#
# 本文件现在只做一件事：正常走完钩子时写下 `pre-commit-ok` 标记，
# 供 `post-commit` 区分「正常提交」与「--no-verify 跳过」并自动留痕。
# 没有门禁可跳过时也不要删掉本文件：删了 post-commit 会把每次提交都记成跳过。
#
# 历史：Flutter 时代的快照守卫 / 超时 / 工具链崩溃放行见
# `.agents/notes/implemented/process/2026-11-07-precommit-kotlin-and-flutter-crash.md`
# 与 git 历史（bab26f1c5 / 4ae35d13e）。

set -e

tree=$(git write-tree 2>/dev/null || true)
if [ -n "$tree" ]; then
  gd=$(git rev-parse --git-dir)
  printf '%s\t%s\n' "$tree" "$(date +%s)" >> "$gd/pre-commit-ok.log" 2>/dev/null || true
fi

exit 0
